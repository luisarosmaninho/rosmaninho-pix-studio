# ─────────────────────────────────────────────────────────────────────────────
# Rosmaninho Fotografia — environment variables
# Copy to .env and fill in the values before starting the server.
# In production, set these as environment variables in your hosting platform.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# Port the dev / preview server listens on. Production platforms (Railway,
# Render, Fly.io, etc.) inject PORT automatically — leave unset and the app
# will use whatever value the platform provides, falling back to 5000.
# PORT=5000

# Node environment. Set to "production" on your hosting platform so the app
# enables production optimisations and the startup JSON→DB seed runs.
NODE_ENV=development

# ── Public URL (CSRF) ─────────────────────────────────────────────────────────
# The canonical public URL of the site (scheme + host, no trailing slash).
# Required when running behind a TLS-terminating reverse proxy (Railway,
# Render, Fly.io, nginx, Cloudflare, …) so the CSRF middleware can verify
# that browser requests come from the correct origin.
# Example: https://rosmaninhofotografia.pt
# SITE_URL=https://example.com

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Optional. Without this value the app runs in JSON-only mode:
# all content is read/written directly from the *-config.json files in the
# project root — ideal for local development without a PostgreSQL instance.
# With this value, the DB is the primary store and the JSON files stay in sync.
DATABASE_URL=postgresql://user:password@localhost:5432/rosmaninho

# ── Admin panel (/admin) ──────────────────────────────────────────────────────
# Password for the content management panel.
# Omitting this uses the default "rosmaninho" — change before going live.
ADMIN_PASSWORD=rosmaninho

# ── Contact form (email) ──────────────────────────────────────────────────────
# SMTP configuration. Without these values, messages are logged to the server
# console but not sent by email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=ola@rosmaninhofotografia.pt
SMTP_PASS=your-smtp-password
CONTACT_EMAIL=ola@rosmaninhofotografia.pt

# ── GitHub publishing (admin "Publicar no GitHub" button) ─────────────────────
# Personal Access Token with write access to the repository.
# Required only if you use the one-click publish button in the admin panel.
# Not needed when deploying via CI/CD or manual git push.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
