# ─────────────────────────────────────────────────────────────────────────────
# Rosmaninho Fotografia — Variáveis de Ambiente
# Copia este ficheiro para .env e preenche os valores.
# Em Replit, configura via Secrets (cadeado na barra lateral) — não uses .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de dados (PostgreSQL) ────────────────────────────────────────────────
# Em Replit: injectado automaticamente pelo add-on PostgreSQL.
# Localmente: usa uma instância PostgreSQL local ou um serviço cloud (ex: Neon, Supabase).
# Se não definires, a aplicação funciona apenas com ficheiros JSON (modo sem base de dados).
DATABASE_URL=postgresql://user:password@localhost:5432/rosmaninho

# ── Admin ─────────────────────────────────────────────────────────────────────
# Palavra-passe para aceder ao painel /admin.
# Se não definires, a palavra-passe por omissão é "rosmaninho" (apenas para desenvolvimento).
# OBRIGATÓRIO em produção.
ADMIN_PASSWORD=rosmaninho

# ── Email (Formulário de contacto) ────────────────────────────────────────────
# Configuração SMTP para enviar emails do formulário de contacto.
# Se não configurares, as mensagens são registadas no servidor mas não enviadas.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=ola@rosmaninhofotografia.pt
SMTP_PASS=password-do-email
CONTACT_EMAIL=ola@rosmaninhofotografia.pt

# ── GitHub (Publicação de conteúdo) ──────────────────────────────────────────
# Token de acesso pessoal com permissão de escrita no repositório.
# Necessário para o botão "Publicar no GitHub" no painel admin.
# Em Replit: configura via Settings → Secrets com o nome GITHUB_TOKEN.
# Localmente: a autenticação SSH funciona automaticamente sem este token.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
