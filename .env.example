# ─────────────────────────────────────────────────────────────────────────────
# Rosmaninho Fotografia — variáveis de ambiente
# Copia para .env e preenche os valores antes de arrancar o servidor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de dados (PostgreSQL) ────────────────────────────────────────────────
# Opcional. Sem este valor a aplicação corre em modo JSON-only:
# toda a informação é lida/escrita directamente nos ficheiros *-config.json
# na raiz do projecto — ideal para desenvolvimento local sem PostgreSQL.
# Com este valor, a DB é usada como store principal e os JSON ficam em sincro.
DATABASE_URL=postgresql://user:password@localhost:5432/rosmaninho

# ── Painel admin (/admin) ─────────────────────────────────────────────────────
# Palavra-passe para entrar no painel de conteúdo.
# Omitir ou deixar em branco usa o valor por omissão "rosmaninho".
# Obrigatório alterar antes de publicar o site.
ADMIN_PASSWORD=rosmaninho

# ── Formulário de contacto (email) ────────────────────────────────────────────
# Configuração SMTP. Sem estes valores as mensagens são registadas no log
# do servidor mas não são enviadas por email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=ola@rosmaninhofotografia.pt
SMTP_PASS=password-do-email
CONTACT_EMAIL=ola@rosmaninhofotografia.pt

# ── Publicação de conteúdo (botão "Publicar no GitHub" no admin) ───────────────
# Personal Access Token do GitHub com permissão de escrita no repositório.
# Necessário apenas para usar o botão de publicação no painel admin via HTTPS.
# Em desenvolvimento local com autenticação SSH configurada este valor
# não é necessário — o git push usa a chave SSH automaticamente.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
